{
  "manifest_version": 3,
  "name": "Poker Assistant — HUD Overlay",
  "version": "1.0.0",
  "description": "War-style tactical HUD overlay for the Poker Assistant study tool. Advisory only: it shows advice from your own manual/Watch inputs, never reads the poker site and never performs a poker action.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_title": "Toggle Poker Assistant HUD overlay",
    "default_icon": {
      "16": "extension/icons/icon16.png",
      "48": "extension/icons/icon48.png",
      "128": "extension/icons/icon128.png"
    }
  },
  "icons": {
    "16": "extension/icons/icon16.png",
    "48": "extension/icons/icon48.png",
    "128": "extension/icons/icon128.png"
  },
  "background": {
    "service_worker": "extension/background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "js/*.js",
        "extension/hud.js",
        "extension/hud-layout.js",
        "extension/hud.css"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
